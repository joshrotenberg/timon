#!/usr/bin/env python3
"""A fake `claude -p` for tests. Never contacts a model.

FAKE_MODE: ok (default), auth (replays recorded/claude-not-logged-in.*), unknown_model, max_turns, is_error
FAKE_TEXT: the result text (default: "echo: " + the prompt)
FAKE_STRUCTURED: JSON for structured_output
FAKE_AUTO_ANSWER: with --json-schema and no FAKE_STRUCTURED, answer with the smallest valid value
FAKE_SESSION: the session id (default: claude-session-1)
FAKE_DELAY: seconds to sleep first
FAKE_PID_FILE: write this process's pid here first
FAKE_LOG_DIR: append {args, prompt, cwd} as claude-N.json
FAKE_TOUCH: a file (relative to the working directory) to write, as an edit
FAKE_RUNNING_DIR: a marker per running process; the count seen at start goes to ../seen-PID
With --output-format stream-json, a Read tool call and its result come before the result line.
FAKE_REPLAY: a recorded stream-json file to print instead (see recorded/README.md)
FAKE_FAIL_ON: fail (as is_error) when the prompt contains this text
"""
import json, os, sys, time


def example(schema):
    """The smallest value matching a JSON Schema timon generates, for FAKE_AUTO_ANSWER."""
    if "anyOf" in schema:
        return example([s for s in schema["anyOf"] if s.get("type") != "null"][0])
    if "enum" in schema:
        return schema["enum"][0]
    kind = schema.get("type")
    if kind == "object":
        return {k: example(v) for k, v in schema.get("properties", {}).items()}
    return {"array": [], "string": "example", "integer": 1, "number": 1.5, "boolean": True}.get(kind)

args = sys.argv[1:]
prompt = sys.stdin.read()
log = os.environ.get("FAKE_LOG_DIR")
if log:
    n = len([f for f in os.listdir(log) if f.startswith("claude-")])
    with open(os.path.join(log, f"claude-{n}.json"), "w") as f:
        json.dump({"args": args, "prompt": prompt, "cwd": os.getcwd()}, f)
if os.environ.get("FAKE_PID_FILE"):
    with open(os.environ["FAKE_PID_FILE"], "w") as f:
        f.write(str(os.getpid()))
running = os.environ.get("FAKE_RUNNING_DIR")
if running:
    marker = os.path.join(running, str(os.getpid()))
    open(marker, "w").close()
    seen = len(os.listdir(running))
    with open(os.path.join(running, "..", f"seen-{os.getpid()}"), "w") as f:
        f.write(str(seen))
time.sleep(float(os.environ.get("FAKE_DELAY", "0")))
if os.environ.get("FAKE_TOUCH"):
    with open(os.environ["FAKE_TOUCH"], "w") as f:
        f.write("changed by the fake\n")
if running:
    os.remove(marker)

session = os.environ.get("FAKE_SESSION", "claude-session-1")
if "--resume" in args:
    session = args[args.index("--resume") + 1]
if "--fork-session" in args:
    session = "claude-forked-1"
mode = os.environ.get("FAKE_MODE", "ok")
if os.environ.get("FAKE_FAIL_ON") and os.environ["FAKE_FAIL_ON"] in prompt:
    mode = "is_error"
result = {
    "type": "result",
    "subtype": "success",
    "is_error": False,
    "result": os.environ.get("FAKE_TEXT", "echo: " + prompt),
    "session_id": session,
    "total_cost_usd": 0.0125,
    "duration_ms": 7,
    "num_turns": 1,
    "usage": {"input_tokens": 120, "output_tokens": 30},
}
if os.environ.get("FAKE_STRUCTURED"):
    result["structured_output"] = json.loads(os.environ["FAKE_STRUCTURED"])
elif os.environ.get("FAKE_AUTO_ANSWER") and "--json-schema" in args:
    result["structured_output"] = example(json.loads(args[args.index("--json-schema") + 1]))

stream = "--output-format" in args and args[args.index("--output-format") + 1] == "stream-json"
if os.environ.get("FAKE_REPLAY"):
    # Replays recorded stream-json output; in json mode, only its result line.
    with open(os.environ["FAKE_REPLAY"]) as f:
        lines = [l for l in f.read().splitlines() if l.strip()]
    print("\n".join(lines) if stream else lines[-1], flush=True)
    sys.exit(0)
if mode == "unknown_model":
    # What Claude Code 2.1.301 does with a model it does not know: a tagged line on stderr, exit 1.
    model = args[args.index("--model") + 1] if "--model" in args else "?"
    sys.stderr.write("[claude-code:unrecognized_model] " + json.dumps({"model": model, "query_source": "sdk"}) + "\n")
    sys.exit(1)
if mode == "auth":
    # Replays what Claude Code 2.1.301 prints when not logged in: the result on stdout, exit 1.
    recorded = os.path.join(os.path.dirname(os.path.abspath(__file__)), "recorded",
                            "claude-not-logged-in.stream.jsonl" if stream else "claude-not-logged-in.json")
    with open(recorded) as f:
        sys.stdout.write(f.read())
    sys.exit(1)
if stream:
    for event in [
        {"type": "system", "subtype": "init", "session_id": session, "model": "fake"},
        {"type": "assistant", "session_id": session, "message": {"role": "assistant", "content": [
            {"type": "thinking", "thinking": "read the readme first"},
            {"type": "tool_use", "id": "t1", "name": "Read", "input": {"file_path": "README.md"}}]}},
        {"type": "user", "session_id": session, "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "t1", "content": [{"type": "text", "text": "# fake readme"}]}]}},
        {"type": "assistant", "session_id": session, "message": {"role": "assistant", "content": [
            {"type": "text", "text": result["result"]}]}},
    ]:
        print(json.dumps(event), flush=True)
if mode == "max_turns":
    result.update(subtype="error_max_turns", is_error=True, result="", num_turns=30)
    print(json.dumps(result))
    sys.exit(1)
if mode == "is_error":
    result.update(subtype="error_during_execution", is_error=True, result="it broke")
print(json.dumps(result))
