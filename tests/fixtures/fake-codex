#!/usr/bin/env python3
"""A fake `codex exec` for tests. Never contacts a model.

FAKE_MODE: ok (default), auth, bad_arg, turn_failed, unknown_model
FAKE_TEXT: the final message (default: "echo: " + the prompt)
FAKE_STRUCTURED: written as the final message instead, as codex does with a schema
FAKE_AUTO_ANSWER: with --output-schema and no FAKE_STRUCTURED, answer with the smallest valid value
FAKE_SESSION: the thread id (default: codex-thread-1)
FAKE_DELAY, FAKE_PID_FILE, FAKE_LOG_DIR: as for fake-claude (files codex-N.json)
FAKE_REPLAY: a recorded exec --json file to print instead (see recorded/README.md)
"""
import json, os, sys, time


def example(schema):
    """The smallest value matching a JSON Schema timon generates, for FAKE_AUTO_ANSWER."""
    if "anyOf" in schema:
        return example([s for s in schema["anyOf"] if s.get("type") != "null"][0])
    if "enum" in schema:
        return schema["enum"][0]
    kind = schema.get("type")
    if kind == "object":
        return {k: example(v) for k, v in schema.get("properties", {}).items()}
    return {"array": [], "string": "example", "integer": 1, "number": 1.5, "boolean": True}.get(kind)

args = sys.argv[1:]
prompt = sys.stdin.read()
log = os.environ.get("FAKE_LOG_DIR")
schema = None
if "--output-schema" in args:
    with open(args[args.index("--output-schema") + 1]) as f:
        schema = json.load(f)
if log:
    n = len([f for f in os.listdir(log) if f.startswith("codex-")])
    with open(os.path.join(log, f"codex-{n}.json"), "w") as f:
        json.dump({"args": args, "prompt": prompt, "cwd": os.getcwd(), "schema": schema}, f)
if os.environ.get("FAKE_PID_FILE"):
    with open(os.environ["FAKE_PID_FILE"], "w") as f:
        f.write(str(os.getpid()))
time.sleep(float(os.environ.get("FAKE_DELAY", "0")))

thread = os.environ.get("FAKE_SESSION", "codex-thread-1")
if "resume" in args:
    after = args[args.index("resume") + 1:]
    named = [a for a in after if not a.startswith("-") and a != "-" and "=" not in a]
    if named:
        thread = named[0]
mode = os.environ.get("FAKE_MODE", "ok")
if os.environ.get("FAKE_FAIL_ON") and os.environ["FAKE_FAIL_ON"] in prompt:
    mode = "turn_failed"
emit = lambda event: print(json.dumps(event), flush=True)

if os.environ.get("FAKE_REPLAY"):
    # Replays recorded exec --json output, and writes its last message as codex would.
    last = ""
    with open(os.environ["FAKE_REPLAY"]) as f:
        for line in f.read().splitlines():
            if not line.strip():
                continue
            print(line, flush=True)
            item = json.loads(line).get("item") or {}
            if item.get("type") == "agent_message":
                last = item.get("text", "")
    if "--output-last-message" in args:
        with open(args[args.index("--output-last-message") + 1], "w") as f:
            f.write(last)
    sys.exit(0)
if mode == "auth":
    sys.stderr.write("unexpected status 401 Unauthorized: Missing bearer or basic authentication\n")
    sys.exit(1)
if mode == "bad_arg":
    # What Codex 0.163.0 prints for an exec flag given before the exec subcommand.
    sys.stderr.write("error: unexpected argument '--skip-git-repo-check' found\n\n"
                     "  tip: to pass '--skip-git-repo-check' as a value, use '-- --skip-git-repo-check'\n\n"
                     "Usage: codex [OPTIONS] [PROMPT]\n       codex [OPTIONS] <COMMAND> [ARGS]\n\n"
                     "For more information, try '--help'.\n")
    sys.exit(2)
emit({"type": "thread.started", "thread_id": thread})
emit({"type": "turn.started"})
emit({"type": "item.completed", "item": {"id": "i0", "type": "reasoning", "text": "list the files"}})
emit({"type": "item.started", "item": {"id": "i1", "type": "command_execution", "command": "bash -lc ls",
                                       "aggregated_output": "", "exit_code": None, "status": "in_progress"}})
emit({"type": "item.completed", "item": {"id": "i1", "type": "command_execution", "command": "bash -lc ls",
                                         "aggregated_output": "README.md\n", "exit_code": 0, "status": "completed"}})
if mode == "unknown_model":
    # What Codex 0.162.0 with a ChatGPT login reports for a model it cannot run.
    inner = {"type": "error", "status": 400, "error": {"type": "invalid_request_error",
             "message": "The 'no-such-model-xyz' model is not supported when using Codex with a ChatGPT account."}}
    emit({"type": "turn.failed", "error": {"message": json.dumps(inner)}})
    sys.exit(1)
if mode == "turn_failed":
    inner = {"error": {"type": "invalid_request_error", "code": "invalid_json_schema",
                       "message": "Invalid schema for response_format"}, "status": 400}
    emit({"type": "turn.failed", "error": {"message": json.dumps(inner)}})
    sys.exit(1)
text = os.environ.get("FAKE_TEXT", "echo: " + prompt)
final = os.environ.get("FAKE_STRUCTURED", text)
if "FAKE_STRUCTURED" not in os.environ and os.environ.get("FAKE_AUTO_ANSWER") and schema:
    final = json.dumps(example(schema))
emit({"type": "item.completed", "item": {"id": "i2", "type": "agent_message", "text": final}})
emit({"type": "turn.completed", "usage": {"input_tokens": 200, "cached_input_tokens": 0, "output_tokens": 40}})
if "--output-last-message" in args:
    with open(args[args.index("--output-last-message") + 1], "w") as f:
        f.write(final)
